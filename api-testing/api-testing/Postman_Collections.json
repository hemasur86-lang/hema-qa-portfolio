  "item": [
    {
      "name": "Login API - Valid",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"test@test.com\", \"password\": \"password123\" }"
        },
        "url": {
          "raw": "https://example.com/api/login",
          "protocol": "https",
          "host": ["example", "com"],
          "path": ["api", "login"]
        }
      }
    },
